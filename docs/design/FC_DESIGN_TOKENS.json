{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Fleet Commander — Captain Intelligence Design System",
  "version": "1.0.0",
  "status": "PROPOSED",
  "direction": "rtl",
  "locale": "ar-EG",
  "density": "comfortable",
  "color": {
    "canvas": "#F3F6F8",
    "surface": "#FFFFFF",
    "surfaceSubtle": "#F8FAFB",
    "surfaceRaised": "#FFFFFF",
    "ink": "#102A3A",
    "inkSoft": "#405B6B",
    "muted": "#6F8390",
    "line": "#DFE7EA",
    "lineStrong": "#C9D6DC",
    "primary": "#087F7B",
    "primaryHover": "#066B68",
    "primaryPressed": "#055B59",
    "primarySubtle": "#E6F4F2",
    "navy": "#102A3A",
    "navyDeep": "#0A1C29",
    "ai": "#635BCA",
    "aiSubtle": "#F0EEFC",
    "success": "#187B58",
    "successSubtle": "#E9F5EF",
    "warning": "#A66B16",
    "warningSubtle": "#FFF4E2",
    "danger": "#B33E46",
    "dangerSubtle": "#FBEDEF",
    "info": "#2B6D9A",
    "infoSubtle": "#EAF3F9",
    "focus": "#2B78B8",
    "overlay": "#0A1C29B8"
